generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanType {
  FREE
  BASIC
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
}

enum AgentType {
  CONVERSATION
  ORDER_MANAGER
  SUGGESTIONS
  MARKETING
  LOYALTY
  FEEDBACK_SURVEY
  REENGAGEMENT
  LEAD_QUALIFIER
  CUSTOM
}


enum QuotaPeriod {
  DAILY
  MONTHLY
}

enum CreditTransactionType {
  TOPUP           // compra de créditos
  AI_USAGE        // débito por uso de IA
  REFUND          // estorno
  ADJUSTMENT      // correção manual/admin
  SUBSCRIPTION_GRANT // créditos incluídos no plano
}

// enum AiModel {
//   GOOGLE_GEMINI_FLASH
//   GOOGLE_GEMINI_FLASH_LITE
//   GOOGLE_GEMINI_PRO
//   CUSTOM
// }

// ─── Business ────────────────────────────────────────

model Business {
  id                 String   @id @default(uuid())
  name               String
  phone              String  @unique
  description        String?
  whatsappInstanceId String  @unique
  whatsappInstanceToken String  @unique
  instanceActive     Boolean @default(false)
  isActive           Boolean  @default(false)
  ownerId            String   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription?
  products      Product[]
  conversations Conversation[]
  orders        Order[]
  availability  Availability?
  agents        Agent[]
  campaigns Campaign[]
  aiUsageQuota AiUsageQuota?
  aiUsageEvents AiUsageEvent[]
  @@index([ownerId])
}

model Plan {
  id              String   @id @default(uuid())
  type            PlanType @unique
  name            String
  description     String?

  stripePriceId   String?  @unique
  amountCents     Int      @default(0)
  currency        String   @default("aoa")

  aiMessageLimit  Int?
  quotaPeriod     QuotaPeriod @default(DAILY)

  rateBurstTokens  Int?         // capacidade máxima do bucket (rajada)
  rateRefillPerSec Float?       // tokens repostos por segundo

  agentSlots      Int      @default(2)
  active          Boolean  @default(true)

  subscriptions          Subscription[] @relation("CurrentPlan")
  scheduledSubscriptions Subscription[] @relation("ScheduledPlan")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Rate & Quota de IA ──────────────────────────────

model AiUsageQuota {
  id          String      @id @default(uuid())
  businessId  String      @unique
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  used        Int         @default(0)
  limit       Int         // snapshot do aiMessageLimit no momento — sobrevive a troca de plano no meio do período
  periodStart DateTime
  periodEnd   DateTime

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([businessId])
}

model AiUsageEvent {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  quantity   Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}


///////////////
model Subscription {
  id                   String              @id @default(uuid())
  businessId           String              @unique
  business             Business            @relation(fields: [businessId], references: [id])

  stripeCustomerId     String              @unique
  stripeSubscriptionId String?             @unique

  planId               String
  plan                 Plan                @relation("CurrentPlan", fields: [planId], references: [id])

  scheduledPlanId      String?
  scheduledPlan        Plan?               @relation("ScheduledPlan", fields: [scheduledPlanId], references: [id])

  status               SubscriptionStatus  @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean             @default(false)
  canceledAt           DateTime?

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([stripeCustomerId])
  @@index([status])
}

// ─── Disponibilidade ─────────────────────────────────

model Availability {
  id           String   @id @default(uuid())
  acceptOrders Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  slots AvailabilitySlot[]
}

model AvailabilitySlot {
  id        String  @id @default(uuid())
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean @default(true)

  availabilityId String
  availability   Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
}

// ─── Agentes ─────────────────────────────────────────

model Agent {
  id          String    @id @default(uuid())
  type        AgentType
  agentSubType String?
  name        String
  description String
  status      Boolean   @default(false)
  isEnabled          Boolean @default(false)


  webhook      String
  systemPrompt String?
  personality  String?  @default("friendly")

  pollTrigger     String? // MARKETING: "after_order" | "on_product_inquiry" | "both"
  pollMinInterval Int?    // MARKETING: dias de intervalo

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]

  // tipos não-CUSTOM: um por business; CUSTOM: múltiplos permitidos
  @@index([businessId])
  @@index([businessId, type])
}

// ─── Campanhas ───────────────────────────────────────

model Campaign {
  id         String         @id @default(uuid())
  name       String?
  message    String
  status     CampaignStatus @default(DRAFT)
  createdAt  DateTime       @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  rules CampaignRule[]
}

model CampaignRule {
  id             String   @id @default(uuid())
  contentType    String
  frequency      String
  customDays     String[]
  timesPerDay    Int      @default(1)
  firstSendTime  String   @default("16:00")
  secondSendTime String?
  audience       String   @default("all")
  flyerKey       String?
  aiPromptHint   String?

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// ─── Produtos & Stock ────────────────────────────────

model Product {
  id          String   @id @default(uuid())
  name        String
  category    String
  price       Float
  unit        String   @default("unidade")
  imageKey    String?
  description String?
  aiSuggested Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  stock      StockItem?
  orderItems OrderItem[]

  @@index([businessId])
}

model StockItem {
  id          String   @id @default(uuid())
  quantity    Int      @default(0)
  minQuantity Int      @default(5)
  updatedAt   DateTime @updatedAt

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─── Conversas & Mensagens ───────────────────────────

model Conversation {
  id        String   @id @default(uuid())
  phone     String
  name      String?
  createdAt DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  messages Message[]
  orders   Order[]

  @@unique([businessId, phone])
  @@index([businessId])
}

model Message {
  id        String   @id @default(uuid())
  role      String
  content   String
  createdAt DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ─── Encomendas ──────────────────────────────────────

model Order {
  id           String      @id @default(uuid())
  status       OrderStatus @default(PENDING)
  scheduledAt  DateTime
  notes        String?
  clientName   String?
  clientNumber String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  items OrderItem[]

  @@index([businessId])
  @@index([conversationId])
}

model OrderItem {
  id        String @id @default(uuid())
  quantity  Int
  unitPrice Float

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}