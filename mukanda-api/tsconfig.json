{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "outDir": "./dist",
    "sourceMap": true,
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@app/prisma": [
        "libs/prisma/src"
      ],
      "@app/prisma/*": [
        "libs/prisma/src/*"
      ],
      "@app/redis": [
        "libs/redis/src"
      ],
      "@app/redis/*": [
        "libs/redis/src/*"
      ],
      "@app/resend": [
        "libs/resend/src"
      ],
      "@app/resend/*": [
        "libs/resend/src/*"
      ],
      "@app/evogo": [
        "libs/evogo/src"
      ],
      "@app/evogo/*": [
        "libs/evogo/src/*"
      ],
      "@app/stripe_p": [
        "libs/stripe_p/src"
      ],
      "@app/stripe_p/*": [
        "libs/stripe_p/src/*"
      ],
      "@app/shared/*":  [
        "libs/shared/src/index.ts"
      ],
    }
  }
}