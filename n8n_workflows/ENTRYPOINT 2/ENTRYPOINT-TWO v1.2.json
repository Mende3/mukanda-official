    {
      "parameters": {
        "jsCode": "// ============================================================\n// Code node do n8n — Mukanda webhook entry point\n// Modo: \"Run Once for All Items\"\n// ============================================================\n\n/**\n * Desembrulha mensagens efémeras/\"ver uma vez\" — o texto real fica\n * dentro de um nível extra (ephemeralMessage.message, etc.), senão\n * o switch abaixo cai sempre no default mesmo sendo texto normal.\n */\nfunction unwrapMessage(message) {\n  const wrapperKeys = ['ephemeralMessage', 'viewOnceMessage', 'viewOnceMessageV2', 'deviceSentMessage'];\n  const key = Object.keys(message ?? {})[0];\n\n  if (wrapperKeys.includes(key) && message[key]?.message) {\n    return unwrapMessage(message[key].message);\n  }\n  return message;\n}\n\n/**\n * Extrai o texto da mensagem — cobre só os tipos de texto por agora\n * (conversation, extendedTextMessage). Qualquer outro tipo (imagem,\n * áudio, etc.) fica marcado como \"unknown\", sem rebentar.\n */\nfunction extractMessageText(rawMessage) {\n  const message = unwrapMessage(rawMessage);\n\n  if (!message || typeof message !== 'object') {\n    return { type: null, text: null };\n  }\n\n  const messageType = Object.keys(message)[0];\n  const content = message[messageType];\n\n  switch (messageType) {\n    case 'conversation':\n      return { type: messageType, text: content ?? null };\n    case 'extendedTextMessage':\n      return { type: messageType, text: content?.text ?? null };\n    default:\n      return { type: messageType ?? 'unknown', text: null };\n  }\n}\n\n/**\n * Percorre recursivamente o objeto todo e recolhe qualquer string\n * terminada em \"@lid\" ou \"@s.whatsapp.net\", seja qual for o nome\n * da chave ou a profundidade. O(n) sobre o total de campos.\n */\nfunction extractJids(data, path = '', result = { lid: [], whatsappNet: [] }) {\n  if (data === null || data === undefined) return result;\n\n  if (Array.isArray(data)) {\n    data.forEach((item, index) => extractJids(item, `${path}[${index}]`, result));\n    return result;\n  }\n\n  if (typeof data === 'object') {\n    for (const [key, value] of Object.entries(data)) {\n      const currentPath = path ? `${path}.${key}` : key;\n\n      if (typeof value === 'string') {\n        if (value.endsWith('@lid')) {\n          result.lid.push({ path: currentPath, value });\n        } else if (value.endsWith('@s.whatsapp.net')) {\n          result.whatsappNet.push({ path: currentPath, value });\n        }\n      } else if (typeof value === 'object' && value !== null) {\n        extractJids(value, currentPath, result);\n      }\n    }\n  }\n\n  return result;\n}\n\n/**\n * Devolve o value do primeiro match de um array de JIDs, ou null\n * se não houver nenhum — nunca undefined, para não desaparecer\n * silenciosamente em JSON.stringify.\n */\nfunction firstJidValue(jidArray) {\n  if (!Array.isArray(jidArray) || jidArray.length === 0) return null;\n  return jidArray[0].value;\n}\n\n// ============================================================\n// Processamento principal\n// ============================================================\n\nconst items = $input.all();\nconst output = [];\n\nfor (const item of items) {\n  const info = item.json?.body?.data?.Info ?? {};\n  const message = item.json?.body?.data?.Message ?? {};\n\n  const jids = extractJids(item.json);\n  const extractedText = extractMessageText(message);\n\n  const firstWhatsappNet = firstJidValue(jids.whatsappNet);\n  const firstLid = firstJidValue(jids.lid);\n\n  // chat cobre o caso em que só existe @lid (sem @s.whatsapp.net nenhum)\n  const chat = info.Chat || firstWhatsappNet || firstLid || null;\n  const isNewsletter = chat?.endsWith('@newsletter') ?? false;\n  const isGroup = info.IsGroup ?? chat?.endsWith('@g.us') ?? false;\n\n  output.push({\n    json: {\n      chat,\n      sender: info.Sender || firstWhatsappNet || null,\n      senderLid: info.SenderAlt || firstLid || null,\n      pushName: info.PushName || null,\n      isGroup,\n      isNewsletter,\n      messageType: extractedText.type,\n      messageText: extractedText.text,\n      timestamp: info.Timestamp ?? null,\n      messageId: info.ID ?? null,\n      instanceId: item.json?.body?.instanceId ?? null,\n      instanceName: item.json?.body?.instanceName ?? null,\n      // conjunto completo, só para auditoria/debug — remove se não precisares\n      _allJids: jids\n    }\n  });\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1696,
        432
      ],
      "id": "372839ac-6a87-4b3e-982d-56eb00b9a13e",
      "name": "get lid and more"
    },
    {
      "parameters": {
        "jsCode": "// ============================================================\n// Code node do n8n — \"Extract First LID\"\n// Modo: \"Run Once for All Items\"\n// Responsabilidade única: devolver o primeiro @lid encontrado\n// em qualquer campo do payload, ou null se não existir.\n// ============================================================\n\nfunction findFirstLid(data, path = '') {\n  if (data === null || data === undefined) return null;\n\n  if (Array.isArray(data)) {\n    for (let i = 0; i < data.length; i++) {\n      const found = findFirstLid(data[i], `${path}[${i}]`);\n      if (found) return found;\n    }\n    return null;\n  }\n\n  if (typeof data === 'object') {\n    for (const [key, value] of Object.entries(data)) {\n      const currentPath = path ? `${path}.${key}` : key;\n\n      if (typeof value === 'string' && value.endsWith('@lid')) {\n        return { path: currentPath, value };\n      }\n\n      if (typeof value === 'object' && value !== null) {\n        const found = findFirstLid(value, currentPath);\n        if (found) return found;\n      }\n    }\n  }\n\n  return null;\n}\n\nconst items = $input.all();\nconst output = [];\n\nfor (const item of items) {\n  const firstLid = findFirstLid(item.json);\n\n  output.push({\n    json: {\n      ...item.json,\n      lid: firstLid?.value ?? null,\n      lidFoundAt: firstLid?.path ?? null   // útil para debug: onde exatamente veio\n    }\n  });\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1456,
        432
      ],
      "id": "b744dff4-8b1c-42c9-a717-0f11ee832551",
