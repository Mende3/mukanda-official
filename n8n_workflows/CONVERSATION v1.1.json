      "parameters": {
        "jsCode": "const data = $input.first().json.output\nconst actions = data.actions || [];\n\nreturn [{\n  json: {\n    reply: data.reply,\n    actions,\n    sendImage:    actions.find(a => a.type === 'send_image')             || null,\n    sendOrder:    actions.find(a => a.type === 'send_order_confirmation') || null,\n    notifyVendor: actions.find(a => a.type === 'notify_vendor')          || null,\n    sendSuggestion: actions.find(a => a.type === 'send_suggestion')      || null,\n    hasImage:     !!actions.find(a => a.type === 'send_image'),\n    hasOrder:     !!actions.find(a => a.type === 'send_order_confirmation')\n  }\n}];"
      },
